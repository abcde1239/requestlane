{
  "name": "requestkit",
  "version": "0.1.2",
  "description": "Typed, framework-independent HTTP clients with opt-in memory caching and Axios/Fetch transports",
  "type": "module",
  "license": "MIT",
  "author": "nwzxx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcde1239/requestkit.git"
  },
  "homepage": "https://github.com/abcde1239/requestkit#readme",
  "bugs": {
    "url": "https://github.com/abcde1239/requestkit/issues"
  },
  "keywords": [
    "typescript",
    "http",
    "fetch",
    "axios",
    "cache",
    "frontend"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "examples",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/adapters/fetch.d.ts",
      "import": "./dist/adapters/fetch.js"
    },
    "./axios": {
      "types": "./dist/adapters/axios.d.ts",
      "import": "./dist/adapters/axios.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./response/sends": {
      "types": "./dist/response/sends.d.ts",
      "import": "./dist/response/sends.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "node scripts/test-coverage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:commit": "node scripts/pre-commit.mjs",
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) import('husky').then(({ default: husky }) => husky())\"",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "verify": "node scripts/verify.mjs",
    "pack:local": "node scripts/pack.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "tsc-alias": "1.9.7",
    "typescript": "7.0.2",
    "typescript-min": "npm:typescript@5.0.4"
  }
}
